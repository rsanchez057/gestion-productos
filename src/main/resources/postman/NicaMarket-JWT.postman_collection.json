{
  "info": {
    "name": "NicaMarket – JWT",
    "description": "Pruebas de autenticación JWT y autorización por rol.\n\nOrden: ejecute primero la carpeta 00 (guarda tokenAdmin y tokenUser) y luego las demás. Ajuste categoriaId a un id de categoría existente. Puede usar Collection Runner para ejecutar todo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Obtener tokens",
      "item": [
        {
          "name": "00a - Login ADMIN (guarda tokenAdmin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login: estado 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Devuelve token Bearer', function () {",
                  "  pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.type).to.eql('Bearer');",
                  "});",
                  "pm.collectionVariables.set('tokenAdmin', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "00b - Login USER (guarda tokenUser)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
