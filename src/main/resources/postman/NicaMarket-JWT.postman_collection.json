        {
          "name": "Prueba 7 - GET /api/productos (token modificado) → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenModificado}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Altera un carácter de la firma para invalidar el token.",
                  "const t = pm.collectionVariables.get('tokenUser');",
                  "if (!t) { throw new Error('Ejecute primero 00 - Login USER'); }",
                  "const p = t.split('.');",
                  "const i = 10;",
                  "p[2] = p[2].substring(0, i) + (p[2][i] === 'A' ? 'B' : 'A') + p[2].substring(i + 1);",
                  "pm.collectionVariables.set('tokenModificado', p.join('.'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
