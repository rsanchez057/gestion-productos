                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "description": "Ajuste la variable de colección categoriaId a un id de categoría existente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"PRB-{{$timestamp}}\",\n  \"nombre\": \"Teclado mecánico\",\n  \"precioVenta\": 75.50,\n  \"existencia\": 20,\n  \"categoriaId\": {{categoriaId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Autorizado: no es 401 ni 403', function () {",
                  "  pm.expect(pm.response.code).to.not.be.oneOf([401, 403]);",
                  "});",
                  "// 200/201 si categoriaId existe; 400/500 indica datos de negocio inválidos, no un fallo de seguridad."
                ]
              }
            }
          ]
        }
